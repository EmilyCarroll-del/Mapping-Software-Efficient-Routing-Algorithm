rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns this document (exact match or {uid}_role format)
    function isOwner(docId) {
      return isAuthenticated() && 
        (docId == request.auth.uid || 
         docId.matches(request.auth.uid + '_.*'));
    }
    
    // Users collection - supports both {uid} and {uid}_admin/{uid}_driver formats
    match /users/{docId} {
      // Allow authenticated users to read any user profile
      allow read: if isAuthenticated();
      
      // Allow write if document ID matches uid or starts with uid_
      allow write: if isOwner(docId);
      
      // Subcollection: routeOptimizations - only owner can access
      match /routeOptimizations/{routeId} {
        allow read, write: if isOwner(docId);
      }
      
      // Subcollection: any other subcollections under user
      match /{subcollection}/{subDocId} {
        allow read, write: if isOwner(docId);
      }
    }
    
    // Orders collection - allow authenticated users to query
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
      allow create: if isAuthenticated();
    }
    
    // Addresses collection - allow authenticated users to query
    match /addresses/{addressId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
      allow create: if isAuthenticated();
    }
    
    // Deliveries collection - allow authenticated users to query
    match /deliveries/{deliveryId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
      allow create: if isAuthenticated();
    }
    
    // Companies collection - all authenticated users can read
    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Codes collection - for company code assignment
    match /codes/{codeId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Code assignments collection - for tracking admin-driver code assignments
    match /code_assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
      allow create: if isAuthenticated();
    }
    
    // Conversations collection - for messaging (new format)
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated() && (
        // New format
        (resource.data.participants != null && request.auth.uid in resource.data.participants) ||
        // Backward compatibility for old format using `users`
        (resource.data.users != null && request.auth.uid in resource.data.users)
      );
      
      allow create: if isAuthenticated();
      
      // Messages subcollection
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }
    
    // Chats collection - for messaging (old format uses 'users' array)
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() && 
        request.auth.uid in resource.data.users;
      
      allow create: if isAuthenticated();
      
      // Messages subcollection
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated();
      allow create: if isAuthenticated();
    }
  }
}
